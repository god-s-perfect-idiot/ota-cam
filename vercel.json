{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastify",
  "buildCommand": "npm run build --workspace web && npm run build --workspace server",
  "installCommand": "npm install",
  "functions": {
    "index.ts": {
      "maxDuration": 60,
      "includeFiles": "web/dist/**"
    }
  }
}
