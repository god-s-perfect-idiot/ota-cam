{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npm install --production=false",
  "buildCommand": "cd .. && node scripts/vercel-build.mjs",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60,
      "includeFiles": "dist/**"
    }
  }
}
