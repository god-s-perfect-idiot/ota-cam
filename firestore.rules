rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: meta
//   Document: host
//     - email: string
//     - refreshTokenEnc: string (AES-GCM encrypted Google refresh token)
//     - connectedAt: string (ISO timestamp)
//     - rootFolderId: string | null
//
// Collection: rolls/{rollId}
//     - id, code, name, driveFolderId, driveFolderUrl, createdAt,
//       expiresAt, closed, photoCap, photoCount
//
// Collection: photos/{photoId}
//     - id, rollId, driveFileId, bytes, mimeType, shooter,
//       clientPhotoId, uploadedAt
//
// Access pattern: only the Node Admin SDK (server) reads/writes.
// Guests and browsers never talk to Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
