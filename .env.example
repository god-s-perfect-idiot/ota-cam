# ---------------------------------------------------------------------------
# ota-cam configuration. Copy to `.env` and fill in.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Where the server listens.
PORT=8787
HOST=0.0.0.0

# Public base URL of the deployed app. Used to build share links and the
# Google OAuth redirect URI, so it must match what you registered in the
# Google Cloud console exactly (scheme + host + port, no trailing slash).
PUBLIC_BASE_URL=http://localhost:8787

# --- Google OAuth (host account only; guests never sign in) ----------------
# Create an "OAuth client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add
# <PUBLIC_BASE_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Secrets ---------------------------------------------------------------
# Password you type to reach /admin and create camera rolls.
ADMIN_PASSWORD=change-me

# 32-byte hex key encrypting the stored Google refresh token at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Signs admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- Limits ----------------------------------------------------------------
# Reject uploads larger than this (bytes). Phone JPEGs are ~1-4 MB.
MAX_UPLOAD_BYTES=15728640

# Safety net so a shared link can't fill your Drive. Per roll.
DEFAULT_ROLL_PHOTO_CAP=500

# Uploads allowed per IP per minute.
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# Where the JSON store and photo log live.
DATA_DIR=./data
